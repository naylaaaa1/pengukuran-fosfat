function stdTable(){$('std').innerHTML='<tr><th>V larutan baku 2 (mL)</th><th>V labu (mL)</th><th>Konsentrasi (mg/L)</th><th>Absorbansi</th><th>Konsentrasi hitung (mg/L)</th><th>% terhadap nominal</th></tr>'+steps.map((s,i)=>`<tr><td><input class="sv" value="${s}"></td><td><input class="sl" value="10"></td><td class="sc"></td><td><input class="sa" placeholder="0.000"></td><td class="sh">-</td><td class="sr">-</td></tr>`).join('')}
